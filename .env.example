# ============================================================
# Atlas-Modified — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# --- Gemini AI ---
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash

# --- Voice / TTS ---
# Options: pyttsx3 (offline, free) | elevenlabs (premium)
TTS_PROVIDER=pyttsx3
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Speech Recognition ---
# Options: google (online, free tier) | vosk (offline)
STT_PROVIDER=google

# --- Wake Word ---
WAKE_WORD=atlas
WAKE_WORD_ENABLED=false

# --- Agent Behavior ---
# Push-to-talk hotkey (e.g. ctrl+space)
ACTIVATION_HOTKEY=ctrl+space
# How many seconds to wait between agent actions
ACTION_DELAY=0.5
# Max retries per failed action
MAX_RETRIES=3

# --- Safety ---
# Ask for confirmation before: move/delete/send etc.
CONFIRM_MEDIUM_RISK=true
CONFIRM_HIGH_RISK=true
# Emergency stop hotkey
EMERGENCY_STOP_HOTKEY=ctrl+shift+F12

# --- Browser ---
# Options: chromium | firefox | webkit
BROWSER_TYPE=chromium
BROWSER_HEADLESS=false

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=logs/
REDACT_SENSITIVE=true
